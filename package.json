{
  "name": "cobuild-indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "db": "ponder db",
    "prepare": "husky",
    "wagmi": "wagmi generate",
    "codegen": "ponder codegen",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test": "vitest --run",
    "typecheck": "tsc",
    "docs:drift": "bash scripts/check-agent-docs-drift.sh",
    "docs:gardening": "bash scripts/doc-gardening.sh --fail-on-issues",
    "review:gpt": "cobuild-review-gpt --config scripts/review-gpt.config.sh",
    "wire:ensure-published": "bash scripts/wire-ensure-published.sh",
    "package:audit-context": "bash scripts/package-audit-context.sh",
    "verify": "pnpm wire:ensure-published && pnpm typecheck && pnpm lint && pnpm docs:drift && pnpm docs:gardening"
  },
  "dependencies": {
    "@cobuild/wire": "^0.3.6",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.5.0",
    "juice-sdk-core": "^2.1.2",
    "ponder": "^0.16.4",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@cobuild/repo-tools": "^0.1.15",
    "@cobuild/review-gpt": "^0.5.72",
    "@types/node": "^20.9.0",
    "@wagmi/cli": "^2.5.1",
    "eslint": "^8.53.0",
    "eslint-config-ponder": "^0.16.4",
    "husky": "^9.1.7",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.14"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {}
}
